# Copy to .env.local for local dev. On Vercel, set these under
# Project -> Settings -> Environment Variables. Never commit real values.

# "true" returns fixture data and needs no other keys. Defaults to true
# while both GROQ_API_KEY and ANTHROPIC_API_KEY are unset.
MOCK=true

# Artificial delay for mock responses, in milliseconds.
MOCK_DELAY_MS=1500

# Comma-separated tokens accepted in the X-Site-Token header. Leave empty to
# accept any request (local testing only). On the production deployment
# (VERCEL_ENV=production) an empty value rejects every request.
SITE_TOKENS=

# Set to "true" only to deliberately run production without SITE_TOKENS.
ALLOW_ANONYMOUS=

# Rate limits per client IP, per hour (0 disables one). "AI" covers
# generate, designs and switch-demo; "light" covers preview and color-map.
RATE_LIMIT_AI_PER_HOUR=15
RATE_LIMIT_REGENERATE_PER_HOUR=60
RATE_LIMIT_LIGHT_PER_HOUR=600
# Cap on LLM-backed requests across all users, per UTC day (0 disables).
AI_DAILY_CAP=3000

# Upstash Redis (REST) shares rate-limit counters across serverless
# instances. Required in production; without it each instance counts on its
# own. The Vercel Upstash integration sets KV_REST_API_URL/TOKEN instead,
# which also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Largest accepted request body in bytes (default 524288).
MAX_BODY_BYTES=

# Comma-separated origins allowed to call the API from a browser, e.g.
# https://example.com,http://fse.local. "*" allows any origin.
ALLOWED_ORIGINS=*

# Live pipeline (MOCK=false). The model must support strict JSON schema.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Live pipeline on Claude instead (LLM_PROVIDER=2).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Which LLM the live pipeline uses: 1 = Groq, 2 = Claude. Unset uses Groq
# when GROQ_API_KEY is set, else Claude.
LLM_PROVIDER=

# "fake" runs the full live pipeline with filler text and no API calls.
LLM=

# Stock photos from https://pixabay.com/api/docs/ (free key). Leave empty to
# keep the demo's own photos.
PIXABAY_API_KEY=
