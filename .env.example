# Copy to .env.local for local dev. On Vercel, set these under
# Project -> Settings -> Environment Variables. Never commit real values.

# "true" returns fixture data and needs no other keys. Defaults to true
# while GROQ_API_KEY is unset.
MOCK=true

# Artificial delay for mock responses, in milliseconds.
MOCK_DELAY_MS=1500

# Comma-separated tokens accepted in the X-Site-Token header. Leave empty to
# accept any request (local testing only).
SITE_TOKENS=

# Comma-separated origins allowed to call the API from a browser, e.g.
# https://example.com,http://fse.local. "*" allows any origin.
ALLOWED_ORIGINS=*

# Live pipeline (MOCK=false). The model must support strict JSON schema.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# "fake" runs the full live pipeline with filler text and no API calls.
LLM=
