							"path": "0.1.0",
							"block": "blockart/heading",
							"attr": "text",
							"kind": "heading",
							"tag": "h2",
							"text": "Our Story",
							"rich": false,
							"words": 2,
							"minWords": 1,
							"maxWords": 4,
							"inHtml": true,
							"placeholder": false
						},
						{
							"id": "fb212093:text",
							"blockId": "fb212093",
							"path": "0.1.1",
							"block": "blockart/paragraph",
							"attr": "text",
							"kind": "paragraph",
							"text": "Founded with a simple belief that education should change lives, UNIGLO has grown into a vibrant learning community welcoming students from around the world.",
							"rich": false,
							"words": 24,
							"minWords": 14,
							"maxWords": 30,
							"inHtml": true,
							"placeholder": false
						},
						{
							"id": "ea0c5273:text",
							"blockId": "ea0c5273",
							"path": "0.1.2",
							"block": "blockart/paragraph",
							"attr": "text",
							"kind": "paragraph",
							"text": "Our programs blend strong academic foundations with hands-on experience. Students learn from dedicated faculty, work on real projects, and gain the practical skills employers value. From the first lecture to graduation day, we support every learner with mentoring, career guidance, and a campus that feels like home.",
							"rich": false,
							"words": 47,
							"minWords": 28,
							"maxWords": 59,
							"inHtml": true,
							"placeholder": false
						},
						{
							"id": "e9ebafcb:text",
							"blockId": "e9ebafcb",
							"path": "0.1.3",
							"block": "blockart/paragraph",
							"attr": "text",
							"kind": "paragraph",
							"text": "Today, thousands of graduates carry the UNIGLO spirit into careers across business, technology, design, science, and beyond. We're proud of where we've come from and excited about where our students are going next.",
							"rich": false,
							"words": 33,
							"minWords": 20,
							"maxWords": 42,
							"inHtml": true,
							"placeholder": false
						}
